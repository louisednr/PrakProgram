set terminal svg
set output "fig1.svg"
set xlabel "x"
set ylabel "y"
set grid
set title "Error Function Approximation vs Table values"
set key right bottom
set tics out
plot [0:3.5] \
	"erf.data" using 1:2  with line title "erf approx from wiki",\
	"table.data" using 1:2 with points pointtype 1 title "table values"



