	set terminal svg; 	set output "decay.svg"; 	set title "Radioactive Decay of ThX (Rutherford & Soddy, 1902)"; 	set xlabel "Time (days)"; 	set ylabel "Activity (relative units)"; 	set grid; 	set key top right; 	stats "fit_results.txt" using 1:2 nooutput; 	a = STATS_min_x; 	lambda = STATS_min_y; 	f(x) = a * exp(-lambda * x); 	plot 		"data.txt" using 1:2:3 with errorbars lt 7 title "Experimental data (with 5%% error)", 		f(x) with lines lw 2 lc rgb "red" title sprintf("Exponential fit: %.2fe^{-%.3fx}", a, lambda); 	
