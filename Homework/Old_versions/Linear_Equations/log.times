	set terminal svg ;	set output "times.svg" ;	set title "Operations count for QR-decomposition";	set xlabel "Matrix dimensions" ;	set ylabel "Real time in (s)" ;	set grid;	set key top left Left reverse; 	a = 0.5; b = 0.5; c = 0.5; d = 0.5; 	f(x) = a*x*x*x + b*x*x + c*x + d ;	fit f(x) "out.times.data" using 1:2 via a,b,c,d ;	plot 		"out.times.data" using 1:2 with points lt 7 title "qr time dependance" 		, f(x) with lines title "fititng to cubic equation O(N^3)" ;	
